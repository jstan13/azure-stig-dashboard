{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": true,
      "basics": {
        "description": "**Azure STIG Dashboard** — full-stack STIG compliance tracker for Azure workloads. This wizard provisions an App Service plan, backend + frontend Web Apps, PostgreSQL Flexible Server, Application Insights, and (optionally) wires Azure AD sign-in. Resources work in **Azure Commercial (portal.azure.com)** and **Azure Government (portal.azure.us)** — the cloud is auto-detected from the portal you launched from, but you can override it on the next step.",
        "location": {
          "label": "Azure region",
          "toolTip": "Pick a region in the cloud you signed in to. For Azure Gov, regions like usgovvirginia / usgovtexas are typical.",
          "resourceTypes": [
            "Microsoft.Web/sites",
            "Microsoft.DBforPostgreSQL/flexibleServers"
          ]
        }
      }
    },
    "basics": [
      {
        "name": "organizationName",
        "type": "Microsoft.Common.TextBox",
        "label": "Organization name",
        "toolTip": "Short identifier for your org (3–14 lowercase letters/digits). Used as the prefix for every resource name (e.g. 'contoso' → 'contoso-stig-api').",
        "defaultValue": "stigdash",
        "constraints": {
          "required": true,
          "regex": "^[a-z][a-z0-9]{2,13}$",
          "validationMessage": "3–14 chars, lowercase letters/numbers, must start with a letter."
        }
      },
      {
        "name": "cloudEnvironment",
        "type": "Microsoft.Common.DropDown",
        "label": "Azure cloud environment",
        "toolTip": "Choose the cloud you are deploying to. This adjusts hostname suffixes, the Microsoft Entra (Azure AD) authority, and the PostgreSQL DNS zone so the deployed app uses the correct sovereign endpoints.",
        "defaultValue": "Azure Commercial (portal.azure.com)",
        "constraints": {
          "allowedValues": [
            { "label": "Azure Commercial (portal.azure.com)", "value": "AzureCloud" },
            { "label": "Azure US Government (portal.azure.us)", "value": "AzureUSGovernment" },
            { "label": "Azure US Gov DoD (portal.azure.us)",   "value": "AzureUSGovernmentDoD" }
          ],
          "required": true
        }
      },
      {
        "name": "appServiceSku",
        "type": "Microsoft.Common.DropDown",
        "label": "App Service plan SKU",
        "defaultValue": "B1 — Basic",
        "toolTip": "Used when auto-size is disabled. For very small environments, keep auto-size enabled instead.",
        "constraints": {
          "allowedValues": [
            { "label": "F1 — Free",       "value": "F1" },
            { "label": "B1 — Basic",      "value": "B1" },
            { "label": "B2 — Basic",      "value": "B2" },
            { "label": "S1 — Standard",   "value": "S1" },
            { "label": "S2 — Standard",   "value": "S2" },
            { "label": "P1v3 — Premium",  "value": "P1v3" }
          ]
        }
      },
      {
        "name": "autoSizeByTrackedHosts",
        "type": "Microsoft.Common.OptionsGroup",
        "label": "Auto-size from tracked host count",
        "defaultValue": "Yes",
        "toolTip": "Recommended. Uses tracked host count to choose lower-cost defaults for SKU, scheduler, and diagnostics.",
        "constraints": {
          "allowedValues": [
            { "label": "Yes", "value": true },
            { "label": "No",  "value": false }
          ],
          "required": true
        }
      },
      {
        "name": "trackedHostCount",
        "type": "Microsoft.Common.TextBox",
        "label": "Estimated tracked hosts",
        "defaultValue": "25",
        "toolTip": "Used when auto-size is enabled. 1-25 defaults to smallest footprint; 26-150 medium; 151+ larger footprint.",
        "constraints": {
          "required": true,
          "regex": "^[1-9][0-9]{0,4}$",
          "validationMessage": "Enter a number from 1 to 99999."
        }
      },
      {
        "name": "enableScheduler",
        "type": "Microsoft.Common.OptionsGroup",
        "label": "Enable scheduled scans/alerts",
        "defaultValue": "Yes",
        "toolTip": "If disabled, no timer-based scan orchestration or drift alerting is deployed.",
        "constraints": {
          "allowedValues": [
            { "label": "Yes", "value": true },
            { "label": "No",  "value": false }
          ],
          "required": true
        }
      },
      {
        "name": "enableDiagnostics",
        "type": "Microsoft.Common.OptionsGroup",
        "label": "Enable centralized diagnostics (Log Analytics)",
        "defaultValue": "No",
        "toolTip": "Can be a major monthly cost driver in small environments.",
        "constraints": {
          "allowedValues": [
            { "label": "Yes", "value": true },
            { "label": "No",  "value": false }
          ],
          "required": true
        }
      },
      {
        "name": "businessHoursMode",
        "type": "Microsoft.Common.OptionsGroup",
        "label": "Business-hours mode",
        "defaultValue": "No",
        "toolTip": "Runs scheduled scan jobs only during business hours in your selected timezone.",
        "constraints": {
          "allowedValues": [
            { "label": "No",  "value": false },
            { "label": "Yes", "value": true }
          ],
          "required": true
        }
      },
      {
        "name": "businessHoursTimeZone",
        "type": "Microsoft.Common.DropDown",
        "label": "Business-hours timezone",
        "defaultValue": "UTC",
        "toolTip": "Timezone the business-hours window is measured in. Only used when business-hours mode is on.",
        "constraints": {
          "required": true,
          "allowedValues": [
            { "label": "UTC",                                  "value": "UTC" },
            { "label": "US Eastern — America/New_York",        "value": "America/New_York" },
            { "label": "US Central — America/Chicago",         "value": "America/Chicago" },
            { "label": "US Mountain — America/Denver",         "value": "America/Denver" },
            { "label": "US Mountain, no DST — America/Phoenix", "value": "America/Phoenix" },
            { "label": "US Pacific — America/Los_Angeles",     "value": "America/Los_Angeles" },
            { "label": "Alaska — America/Anchorage",           "value": "America/Anchorage" },
            { "label": "Hawaii — Pacific/Honolulu",            "value": "Pacific/Honolulu" },
            { "label": "Atlantic — America/Puerto_Rico",       "value": "America/Puerto_Rico" },
            { "label": "UK — Europe/London",                   "value": "Europe/London" },
            { "label": "Central Europe — Europe/Berlin",       "value": "Europe/Berlin" },
            { "label": "Central Europe — Europe/Paris",        "value": "Europe/Paris" },
            { "label": "Eastern Europe — Europe/Athens",       "value": "Europe/Athens" },
            { "label": "Israel — Asia/Jerusalem",              "value": "Asia/Jerusalem" },
            { "label": "Gulf — Asia/Dubai",                    "value": "Asia/Dubai" },
            { "label": "India — Asia/Kolkata",                 "value": "Asia/Kolkata" },
            { "label": "Singapore — Asia/Singapore",           "value": "Asia/Singapore" },
            { "label": "China — Asia/Shanghai",                "value": "Asia/Shanghai" },
            { "label": "Korea — Asia/Seoul",                   "value": "Asia/Seoul" },
            { "label": "Japan — Asia/Tokyo",                   "value": "Asia/Tokyo" },
            { "label": "Australia East — Australia/Sydney",    "value": "Australia/Sydney" },
            { "label": "Australia West — Australia/Perth",     "value": "Australia/Perth" },
            { "label": "New Zealand — Pacific/Auckland",       "value": "Pacific/Auckland" }
          ]
        }
      },
      {
        "name": "businessHoursStartHour",
        "type": "Microsoft.Common.TextBox",
        "label": "Business day start hour (0-23)",
        "defaultValue": "8",
        "constraints": {
          "required": true,
          "regex": "^(?:[0-9]|1[0-9]|2[0-3])$",
          "validationMessage": "Enter a value from 0 to 23."
        }
      },
      {
        "name": "businessHoursEndHour",
        "type": "Microsoft.Common.TextBox",
        "label": "Business day end hour (0-23)",
        "defaultValue": "18",
        "constraints": {
          "required": true,
          "regex": "^(?:[0-9]|1[0-9]|2[0-3])$",
          "validationMessage": "Enter a value from 0 to 23."
        }
      },
      {
        "name": "autoShutdownOutsideBusinessHours",
        "type": "Microsoft.Common.OptionsGroup",
        "label": "Auto-stop app + DB outside business hours",
        "defaultValue": "No",
        "toolTip": "When enabled with Scheduler + Business-hours mode, the Function app starts/stops backend, frontend, and PostgreSQL on a weekday schedule.",
        "constraints": {
          "allowedValues": [
            { "label": "No",  "value": false },
            { "label": "Yes", "value": true }
          ],
          "required": true
        }
      },
      {
        "name": "autoUpdateMode",
        "type": "Microsoft.Common.OptionsGroup",
        "label": "Automatic updates",
        "defaultValue": "Notify me only",
        "toolTip": "New versions ship as container images. 'Install automatically' swaps the image during your maintenance window and puts the old version back if the new one fails its health check. Your data is never touched.",
        "constraints": {
          "allowedValues": [
            { "label": "Off — never check",              "value": "off" },
            { "label": "Notify me only",                 "value": "notify" },
            { "label": "Install automatically",          "value": "auto" }
          ],
          "required": true
        }
      },
      {
        "name": "autoUpdateRequireApproval",
        "type": "Microsoft.Common.OptionsGroup",
        "label": "Require approval for each update",
        "defaultValue": "Approve each one",
        "toolTip": "'Approve each one' holds every release until an administrator signs off on the Updates page. 'Set and forget' installs them unattended during the maintenance window. You can change this later in the app.",
        "visible": "[equals(basics('autoUpdateMode'), 'auto')]",
        "constraints": {
          "allowedValues": [
            { "label": "Approve each one", "value": true },
            { "label": "Set and forget",   "value": false }
          ],
          "required": true
        }
      },
      {
        "name": "autoUpdateDay",
        "type": "Microsoft.Common.DropDown",
        "label": "Update day",
        "defaultValue": "Any day",
        "visible": "[equals(basics('autoUpdateMode'), 'auto')]",
        "constraints": {
          "required": true,
          "allowedValues": [
            { "label": "Any day",   "value": "-1" },
            { "label": "Sunday",    "value": "0" },
            { "label": "Monday",    "value": "1" },
            { "label": "Tuesday",   "value": "2" },
            { "label": "Wednesday", "value": "3" },
            { "label": "Thursday",  "value": "4" },
            { "label": "Friday",    "value": "5" },
            { "label": "Saturday",  "value": "6" }
          ]
        }
      },
      {
        "name": "autoUpdateHour",
        "type": "Microsoft.Common.TextBox",
        "label": "Update hour (0-23)",
        "defaultValue": "2",
        "toolTip": "Hour, in the timezone below, when updates may install. Expect a short outage while the app restarts.",
        "visible": "[equals(basics('autoUpdateMode'), 'auto')]",
        "constraints": {
          "required": true,
          "regex": "^(?:[0-9]|1[0-9]|2[0-3])$",
          "validationMessage": "Enter a value from 0 to 23."
        }
      },
      {
        "name": "autoUpdateTimeZone",
        "type": "Microsoft.Common.DropDown",
        "label": "Update timezone",
        "defaultValue": "UTC",
        "visible": "[equals(basics('autoUpdateMode'), 'auto')]",
        "constraints": {
          "required": true,
          "allowedValues": [
            { "label": "UTC",                                  "value": "UTC" },
            { "label": "US Eastern — America/New_York",        "value": "America/New_York" },
            { "label": "US Central — America/Chicago",         "value": "America/Chicago" },
            { "label": "US Mountain — America/Denver",         "value": "America/Denver" },
            { "label": "US Mountain, no DST — America/Phoenix", "value": "America/Phoenix" },
            { "label": "US Pacific — America/Los_Angeles",     "value": "America/Los_Angeles" },
            { "label": "Alaska — America/Anchorage",           "value": "America/Anchorage" },
            { "label": "Hawaii — Pacific/Honolulu",            "value": "Pacific/Honolulu" },
            { "label": "Atlantic — America/Puerto_Rico",       "value": "America/Puerto_Rico" },
            { "label": "UK — Europe/London",                   "value": "Europe/London" },
            { "label": "Central Europe — Europe/Berlin",       "value": "Europe/Berlin" },
            { "label": "Central Europe — Europe/Paris",        "value": "Europe/Paris" },
            { "label": "Eastern Europe — Europe/Athens",       "value": "Europe/Athens" },
            { "label": "Israel — Asia/Jerusalem",              "value": "Asia/Jerusalem" },
            { "label": "Gulf — Asia/Dubai",                    "value": "Asia/Dubai" },
            { "label": "India — Asia/Kolkata",                 "value": "Asia/Kolkata" },
            { "label": "Singapore — Asia/Singapore",           "value": "Asia/Singapore" },
            { "label": "China — Asia/Shanghai",                "value": "Asia/Shanghai" },
            { "label": "Korea — Asia/Seoul",                   "value": "Asia/Seoul" },
            { "label": "Japan — Asia/Tokyo",                   "value": "Asia/Tokyo" },
            { "label": "Australia East — Australia/Sydney",    "value": "Australia/Sydney" },
            { "label": "Australia West — Australia/Perth",     "value": "Australia/Perth" },
            { "label": "New Zealand — Pacific/Auckland",       "value": "Pacific/Auckland" }
          ]
        }
      },
      {
        "name": "mockMode",
        "type": "Microsoft.Common.OptionsGroup",
        "label": "Run in demo mode (seeded sample data, sign-in disabled)",
        "defaultValue": "No",
        "toolTip": "Demo mode serves sample data, skips sign-in and accepts every API request unauthenticated. Use it to try the app out; leave at 'No' for anything holding real data.",
        "constraints": {
          "allowedValues": [
            { "label": "No",  "value": false },
            { "label": "Yes", "value": true }
          ],
          "required": true
        }
      }
    ],
    "steps": [
      {
        "name": "azureAd",
        "label": "Azure AD sign-in",
        "subLabel": {
          "preValidation": "Provide your Microsoft Entra app registration",
          "postValidation": "Done"
        },        "bladeTitle": "Microsoft Entra ID (Azure AD)",
        "elements": [
          {
            "name": "azureAdSkipped",
            "type": "Microsoft.Common.InfoBox",
            "visible": "[basics('mockMode')]",
            "options": {
              "icon": "Info",
              "text": "Demo mode is switched on, so sign-in is disabled and nothing on this page is needed. Select **Next**. To move to real sign-in later, redeploy with demo mode set to No and fill this page in."
            }
          },
          {
            "name": "azureAdInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": "[not(basics('mockMode'))]",
            "options": {
              "icon": "Info",
              "text": "This deployment cannot create the app registration for you — app registrations live in Microsoft Entra ID, which Azure Resource Manager templates cannot write to. Create it first by cloning the repo and running `./scripts/create-app-registration.ps1 -OrgName <your-org>`; it creates the registration, exposes the API scope, defines the admin/operator/auditor roles, sets the redirect URI, generates a client secret, and prints the two values you need below. To do it by hand instead, create an app registration with the SPA redirect URI `https://<organization>-stig-web.<azurewebsites-suffix>` and an API scope `api://<client-id>/access_as_user`."
            }
          },
          {
            "name": "tenantSource",
            "type": "Microsoft.Common.OptionsGroup",
            "label": "Which Microsoft Entra tenant?",
            "defaultValue": "Use the tenant this subscription belongs to",
            "visible": "[not(basics('mockMode'))]",
            "toolTip": "Almost always the tenant you are signed in to. Override only if the app registration lives in a different tenant.",
            "constraints": {
              "required": true,
              "allowedValues": [
                { "label": "Use the tenant this subscription belongs to", "value": "current" },
                { "label": "Enter a different tenant ID",                 "value": "custom" }
              ]
            }
          },
          {
            "name": "tenantDetected",
            "type": "Microsoft.Common.InfoBox",
            "visible": "[and(not(basics('mockMode')), equals(steps('azureAd').tenantSource, 'current'))]",
            "options": {
              "icon": "Info",
              "text": "[concat('Detected tenant: ', subscription().tenantId)]"
            }
          },
          {
            "name": "azureTenantIdOverride",
            "type": "Microsoft.Common.TextBox",
            "label": "Tenant ID",
            "toolTip": "GUID of the Microsoft Entra tenant holding the app registration.",
            "visible": "[and(not(basics('mockMode')), equals(steps('azureAd').tenantSource, 'custom'))]",
            "constraints": {
              "required": "[and(not(basics('mockMode')), equals(steps('azureAd').tenantSource, 'custom'))]",
              "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "validationMessage": "Enter a valid GUID."
            }
          },
          {
            "name": "azureClientId",
            "type": "Microsoft.Common.TextBox",
            "label": "Application (client) ID",
            "toolTip": "GUID of the app registration.",
            "visible": "[not(basics('mockMode'))]",
            "constraints": {
              "required": "[not(basics('mockMode'))]",
              "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "validationMessage": "Enter a valid GUID."
            }
          },
          {
            "name": "azureClientSecret",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Client secret",
              "confirmPassword": "Confirm client secret"
            },
            "toolTip": "App registration client secret. Stored in the deployment's Key Vault and referenced by the backend.",
            "visible": "[not(basics('mockMode'))]",
            "constraints": {
              "required": "[not(basics('mockMode'))]",
              "regex": "^.{8,}$",
              "validationMessage": "Client secret must be at least 8 characters."
            },
            "options": { "hideConfirmation": false }
          }
        ]
      },
      {
        "name": "database",
        "label": "PostgreSQL",
        "bladeTitle": "PostgreSQL Flexible Server",
        "visible": "[not(basics('mockMode'))]",
        "elements": [
          {
            "name": "dbAdminLogin",
            "type": "Microsoft.Common.TextBox",
            "label": "Database admin login",
            "defaultValue": "stigadmin",
            "toolTip": "Lowercase, must not be a reserved word (admin/root/etc.).",
            "constraints": {
              "required": "[not(basics('mockMode'))]",
              "regex": "^[a-z][a-z0-9]{2,15}$",
              "validationMessage": "3–16 chars, lowercase letters/digits, start with a letter."
            }
          },
          {
            "name": "dbAdminPassword",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Database admin password",
              "confirmPassword": "Confirm password"
            },
            "toolTip": "12+ chars, must include uppercase, lowercase, digit, and symbol.",
            "constraints": {
              "required": "[not(basics('mockMode'))]",
              "regex": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z0-9]).{12,}$",
              "validationMessage": "12+ chars including upper, lower, digit, and symbol."
            },
            "options": { "hideConfirmation": false }
          }
        ]
      }
    ],
    "outputs": {
      "baseName":          "[concat(basics('organizationName'), '-stig')]",
      "location":          "[location()]",
      "cloudEnvironment":  "[basics('cloudEnvironment')]",
      "appServiceSku":     "[basics('appServiceSku')]",
      "autoSizeByTrackedHosts": "[basics('autoSizeByTrackedHosts')]",
      "trackedHostCount": "[int(basics('trackedHostCount'))]",
      "enableScheduler": "[basics('enableScheduler')]",
      "enableDiagnostics": "[basics('enableDiagnostics')]",
      "businessHoursMode": "[basics('businessHoursMode')]",
      "businessHoursTimeZone": "[basics('businessHoursTimeZone')]",
      "businessHoursStartHour": "[int(basics('businessHoursStartHour'))]",
      "businessHoursEndHour": "[int(basics('businessHoursEndHour'))]",
      "autoShutdownOutsideBusinessHours": "[basics('autoShutdownOutsideBusinessHours')]",
      "autoUpdateMode": "[basics('autoUpdateMode')]",
      "autoUpdateRequireApproval": "[if(equals(basics('autoUpdateMode'), 'auto'), basics('autoUpdateRequireApproval'), true)]",
      "autoUpdateDay": "[if(equals(basics('autoUpdateMode'), 'auto'), int(basics('autoUpdateDay')), -1)]",
      "autoUpdateHour": "[if(equals(basics('autoUpdateMode'), 'auto'), int(basics('autoUpdateHour')), 2)]",
      "autoUpdateTimeZone": "[if(equals(basics('autoUpdateMode'), 'auto'), basics('autoUpdateTimeZone'), 'UTC')]",
      "mockMode":          "[basics('mockMode')]",
      "azureTenantId":     "[if(equals(steps('azureAd').tenantSource, 'custom'), steps('azureAd').azureTenantIdOverride, subscription().tenantId)]",
      "azureClientId":     "[steps('azureAd').azureClientId]",
      "azureClientSecret": "[steps('azureAd').azureClientSecret]",
      "dbAdminLogin":      "[if(basics('mockMode'), 'stigadmin', steps('database').dbAdminLogin)]",
      "dbAdminPassword":   "[if(basics('mockMode'), '', steps('database').dbAdminPassword)]"
    }
  }
}
