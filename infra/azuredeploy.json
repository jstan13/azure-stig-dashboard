{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.1.0.0",
  "metadata": {
    "description": "Azure STIG Dashboard \u2014 deploys App Service (backend+frontend), PostgreSQL Flexible Server, and Application Insights. Cloud-aware: works in Azure Commercial (portal.azure.com) and Azure US Government (portal.azure.us)."
  },
  "parameters": {
    "baseName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 14,
      "defaultValue": "stigdash",
      "metadata": { "description": "Organization / resource name prefix (lowercase alphanumeric, must start with a letter)." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region. Must belong to the selected cloudEnvironment." }
    },
    "cloudEnvironment": {
      "type": "string",
      "defaultValue": "AzureCloud",
      "allowedValues": [
        "AzureCloud",
        "AzureUSGovernment",
        "AzureUSGovernmentDoD"
      ],
      "metadata": { "description": "Target Azure cloud. Drives App Service / Postgres / Microsoft Entra hostname suffixes." }
    },
    "appServiceSku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": ["F1","B1","B2","S1","S2","P1v3"],
      "metadata": { "description": "App Service plan SKU." }
    },
    "azureTenantId": {
      "type": "string",
      "metadata": { "description": "Microsoft Entra (Azure AD) tenant ID." }
    },
    "azureClientId": {
      "type": "string",
      "metadata": { "description": "Microsoft Entra app registration (client) ID." }
    },
    "azureClientSecret": {
      "type": "securestring",
      "metadata": { "description": "Microsoft Entra app registration client secret." }
    },
    "dbAdminLogin": {
      "type": "string",
      "defaultValue": "stigadmin",
      "metadata": { "description": "PostgreSQL admin login." }
    },
    "dbAdminPassword": {
      "type": "securestring",
      "metadata": { "description": "PostgreSQL admin password (12+ chars, complexity required)." }
    },
    "mockMode": {
      "type": "bool",
      "defaultValue": false,
      "metadata": { "description": "Set to true to run without real Azure subscription data (demo only). MUST be false in production." }
    },
    "strictTraceability": {
      "type": "bool",
      "defaultValue": true,
      "metadata": { "description": "Enforce constitution Principle IV / FR-009: every exported finding must carry a complete mappingChain." }
    },
    "lockdownNetworking": {
      "type": "bool",
      "defaultValue": false,
      "metadata": { "description": "When true, disables public telemetry/query and enables App Service CIDR-based ingress allow-list enforcement." }
    },
    "allowedIngressCidrs": {
      "type": "array",
      "defaultValue": [],
      "metadata": { "description": "CIDRs allowed to reach frontend/backend when lockdownNetworking=true." }
    },
    "remediationTargetResourceGroupName": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "Optional resource group containing VMs/Arc machines this app is allowed to remediate. Leave empty to skip RunCommand role assignment." }
    },
    "backendImage": {
      "type": "string",
      "defaultValue": "ghcr.io/jstan13/stig-backend:latest",
      "metadata": { "description": "Backend container image reference. Release builds pin this to an immutable @sha256:<digest> — do not loosen unless you know what you are doing." }
    },
    "frontendImage": {
      "type": "string",
      "defaultValue": "ghcr.io/jstan13/stig-frontend:latest",
      "metadata": { "description": "Frontend container image reference. Release builds pin this to an immutable @sha256:<digest>." }
    }
  },
  "variables": {
    "isGov":         "[or(equals(parameters('cloudEnvironment'),'AzureUSGovernment'), equals(parameters('cloudEnvironment'),'AzureUSGovernmentDoD'))]",
    "appHostSuffix": "[if(variables('isGov'), 'azurewebsites.us', 'azurewebsites.net')]",
    "pgHostSuffix":  "[if(variables('isGov'), 'postgres.database.usgovcloudapi.net', 'postgres.database.azure.com')]",
    "authorityHost": "[if(variables('isGov'), 'https://login.microsoftonline.us', 'https://login.microsoftonline.com')]",
    "graphHost":     "[if(variables('isGov'), 'https://graph.microsoft.us', 'https://graph.microsoft.com')]",
    "armHost":       "[if(variables('isGov'), 'https://management.usgovcloudapi.net', 'https://management.azure.com')]",
    "planName":     "[concat(parameters('baseName'), '-stig-plan')]",
    "backendName":  "[concat(parameters('baseName'), '-stig-api')]",
    "frontendName": "[concat(parameters('baseName'), '-stig-web')]",
    "dbServerName": "[concat(parameters('baseName'), '-stig-pg')]",
    "dbName":       "stigdashboard",
    "aiName":       "[concat(parameters('baseName'), '-stig-ai')]",
    "keyVaultName": "[take(replace(concat(parameters('baseName'), '-stig-kv'), '-', ''), 24)]",
    "kvSecretsUserRoleId": "4633458b-17de-457c-a5dd-322bbab69ee3",
    "dbConnectionString": "[concat('postgresql://', parameters('dbAdminLogin'), ':', parameters('dbAdminPassword'), '@', variables('dbServerName'), '.', variables('pgHostSuffix'), ':5432/', variables('dbName'), '?sslmode=require')]"
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": { "family": "A", "name": "standard" },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "publicNetworkAccess": "[if(parameters('lockdownNetworking'), 'Disabled', 'Enabled')]"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[concat(variables('keyVaultName'), '/AZURE-CLIENT-SECRET')]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ],
      "properties": { "value": "[parameters('azureClientSecret')]" }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[concat(variables('keyVaultName'), '/DATABASE-URL')]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('dbServerName'))]"
      ],
      "properties": { "value": "[variables('dbConnectionString')]" }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('aiName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "publicNetworkAccessForIngestion": "[if(parameters('lockdownNetworking'), 'Disabled', 'Enabled')]",
        "publicNetworkAccessForQuery": "[if(parameters('lockdownNetworking'), 'Disabled', 'Enabled')]"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "[parameters('appServiceSku')]" },
      "kind": "linux",
      "properties": { "reserved": true }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2023-06-01-preview",
      "name": "[variables('dbServerName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard_B1ms", "tier": "Burstable" },
      "properties": {
        "administratorLogin": "[parameters('dbAdminLogin')]",
        "administratorLoginPassword": "[parameters('dbAdminPassword')]",
        "version": "16",
        "storage": { "storageSizeGB": 32 },
        "backup": { "backupRetentionDays": 7, "geoRedundantBackup": "Disabled" },
        "highAvailability": { "mode": "Disabled" },
        "authConfig": { "activeDirectoryAuth": "Disabled", "passwordAuth": "Enabled" }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2023-06-01-preview",
      "condition": "[not(parameters('lockdownNetworking'))]",
      "name": "[concat(variables('dbServerName'), '/AllowAzureServices')]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('dbServerName'))]"
      ],
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress":   "0.0.0.0"
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/configurations",
      "apiVersion": "2023-06-01-preview",
      "name": "[concat(variables('dbServerName'), '/require_secure_transport')]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('dbServerName'))]"
      ],
      "properties": {
        "value": "ON",
        "source": "user-override"
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2023-06-01-preview",
      "name": "[concat(variables('dbServerName'), '/', variables('dbName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('dbServerName'))]"
      ],
      "properties": { "charset": "UTF8", "collation": "en_US.utf8" }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[variables('backendName')]",
      "location": "[parameters('location')]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[resourceId('Microsoft.Insights/components', variables('aiName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', variables('dbServerName'), variables('dbName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), 'AZURE-CLIENT-SECRET')]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), 'DATABASE-URL')]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[concat('DOCKER|', parameters('backendImage'))]",
          "alwaysOn": "[not(equals(parameters('appServiceSku'),'F1'))]",
          "http20Enabled": true,
          "minTlsVersion": "1.2",
          "ipSecurityRestrictionsDefaultAction": "[if(parameters('lockdownNetworking'), 'Deny', 'Allow')]",
          "scmIpSecurityRestrictionsDefaultAction": "[if(parameters('lockdownNetworking'), 'Deny', 'Allow')]",
          "ipSecurityRestrictions": [],
          "appSettings": [
            { "name": "DOCKER_REGISTRY_SERVER_URL",    "value": "https://ghcr.io" },
            { "name": "WEBSITES_PORT",                 "value": "3001" },
            { "name": "WEBSITES_ENABLE_APP_SERVICE_STORAGE", "value": "false" },
            { "name": "NODE_ENV",                       "value": "production" },
            { "name": "MOCK_MODE",                      "value": "[if(parameters('mockMode'), 'true', 'false')]" },
            { "name": "STRICT_TRACEABILITY",            "value": "[if(parameters('strictTraceability'), 'true', 'false')]" },
            { "name": "AZURE_CLOUD",                    "value": "[parameters('cloudEnvironment')]" },
            { "name": "AZURE_AUTHORITY_HOST",           "value": "[variables('authorityHost')]" },
            { "name": "AZURE_GRAPH_ENDPOINT",           "value": "[variables('graphHost')]" },
            { "name": "AZURE_ARM_ENDPOINT",             "value": "[variables('armHost')]" },
            { "name": "AZURE_TENANT_ID",                "value": "[parameters('azureTenantId')]" },
            { "name": "AZURE_CLIENT_ID",                "value": "[parameters('azureClientId')]" },
            { "name": "AZURE_CLIENT_SECRET",            "value": "[concat('@Microsoft.KeyVault(SecretUri=', reference(resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), 'AZURE-CLIENT-SECRET'), '2023-07-01').secretUri, ')')]" },
            { "name": "DATABASE_URL",                   "value": "[concat('@Microsoft.KeyVault(SecretUri=', reference(resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), 'DATABASE-URL'), '2023-07-01').secretUri, ')')]" },
            { "name": "DB_SSL",                         "value": "true" },
            { "name": "APPINSIGHTS_INSTRUMENTATIONKEY", "value": "[reference(resourceId('Microsoft.Insights/components', variables('aiName')), '2020-02-02').InstrumentationKey]" },
            { "name": "FRONTEND_URL",                   "value": "[concat('https://', variables('frontendName'), '.', variables('appHostSuffix'))]" }
          ]
        }
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[concat(variables('keyVaultName'), '/Microsoft.Authorization/', guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), variables('backendName'), variables('kvSecretsUserRoleId')))]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.Web/sites', variables('backendName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('kvSecretsUserRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('backendName')), '2023-01-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleDefinitions",
      "apiVersion": "2022-05-01-preview",
      "condition": "[not(empty(parameters('remediationTargetResourceGroupName')))]",
      "scope": "[subscription().id]",
      "name": "[guid(subscription().id, parameters('remediationTargetResourceGroupName'), 'runcommand-remediation-role')]",
      "properties": {
        "roleName": "[concat(parameters('baseName'), '-runcommand-remediator')]",
        "description": "Least-privilege role for STIG remediation RunCommand execution only.",
        "type": "CustomRole",
        "permissions": [
          {
            "actions": [
              "Microsoft.Compute/virtualMachines/read",
              "Microsoft.Compute/virtualMachines/runCommand/action",
              "Microsoft.HybridCompute/machines/read",
              "Microsoft.HybridCompute/machines/runCommand/action"
            ],
            "notActions": [],
            "dataActions": [],
            "notDataActions": []
          }
        ],
        "assignableScopes": [
          "[resourceId('Microsoft.Resources/resourceGroups', parameters('remediationTargetResourceGroupName'))]"
        ]
      }
    },
    {
      "type": "Microsoft.Resources/resourceGroups/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "condition": "[not(empty(parameters('remediationTargetResourceGroupName')))]",
      "name": "[concat(parameters('remediationTargetResourceGroupName'), '/Microsoft.Authorization/', guid(resourceId('Microsoft.Resources/resourceGroups', parameters('remediationTargetResourceGroupName')), reference(resourceId('Microsoft.Web/sites', variables('backendName')), '2023-01-01', 'Full').identity.principalId, 'runcommand-remediation-assignment'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('backendName'))]",
        "[resourceId('Microsoft.Authorization/roleDefinitions', guid(subscription().id, parameters('remediationTargetResourceGroupName'), 'runcommand-remediation-role'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', guid(subscription().id, parameters('remediationTargetResourceGroupName'), 'runcommand-remediation-role'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('backendName')), '2023-01-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[variables('frontendName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[concat('DOCKER|', parameters('frontendImage'))]",
          "http20Enabled": true,
          "minTlsVersion": "1.2",
          "ipSecurityRestrictionsDefaultAction": "[if(parameters('lockdownNetworking'), 'Deny', 'Allow')]",
          "scmIpSecurityRestrictionsDefaultAction": "[if(parameters('lockdownNetworking'), 'Deny', 'Allow')]",
          "ipSecurityRestrictions": [],
          "appSettings": [
            { "name": "DOCKER_REGISTRY_SERVER_URL",    "value": "https://ghcr.io" },
            { "name": "WEBSITES_PORT",                 "value": "8080" },
            { "name": "WEBSITES_ENABLE_APP_SERVICE_STORAGE", "value": "false" },
            { "name": "AZURE_CLIENT_ID",      "value": "[parameters('azureClientId')]" },
            { "name": "AZURE_TENANT_ID",      "value": "[parameters('azureTenantId')]" },
            { "name": "AZURE_CLOUD",          "value": "[parameters('cloudEnvironment')]" },
            { "name": "AZURE_AUTHORITY_HOST", "value": "[variables('authorityHost')]" },
            { "name": "API_URL",              "value": "[concat('https://', variables('backendName'), '.', variables('appHostSuffix'), '/api')]" },
            { "name": "API_SCOPE",            "value": "[concat('api://', parameters('azureClientId'), '/access_as_user')]" },
            { "name": "MOCK_MODE",            "value": "[if(parameters('mockMode'), 'true', 'false')]" }
          ]
        }
      }
    }
  ],
  "outputs": {
    "cloudEnvironment": { "type": "string", "value": "[parameters('cloudEnvironment')]" },
    "backendUrl":  { "type": "string", "value": "[concat('https://', variables('backendName'), '.', variables('appHostSuffix'))]" },
    "frontendUrl": { "type": "string", "value": "[concat('https://', variables('frontendName'), '.', variables('appHostSuffix'))]" },
    "redirectUriToConfigure": {
      "type": "string",
      "value": "[concat('https://', variables('frontendName'), '.', variables('appHostSuffix'))]"
    },
    "backendPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('backendName')), '2023-01-01', 'Full').identity.principalId]"
    }
  }
}
