        "httpsOnly": true,
        "siteConfig": {
          "copy": [
            {
              "name": "ipSecurityRestrictions",
              "count": "[length(parameters('allowedIngressCidrs'))]",
              "input": {
                "ipAddress": "[parameters('allowedIngressCidrs')[copyIndex('ipSecurityRestrictions')]]",
                "action": "Allow",
                "priority": "[add(100, copyIndex('ipSecurityRestrictions'))]",
                "name": "[format('allow-{0}', copyIndex('ipSecurityRestrictions'))]"
              }
            }
          ],
          "linuxFxVersion": "[variables('frontendLinuxFxVersion')]",
