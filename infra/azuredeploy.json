{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "15899706297398472349"
    }
  },
  "parameters": {
    "baseName": {
      "type": "string",
      "defaultValue": "stigdash",
      "minLength": 3,
      "maxLength": 20,
      "metadata": {
        "description": "Base name used for all resources (lowercase letters and numbers only, 3-20 chars)"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources"
      }
    },
    "appServiceSku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "F1",
        "B1",
        "B2",
        "S1",
        "S2",
        "P1v3"
      ],
      "metadata": {
        "description": "App Service SKU (used when autoSizeByTrackedHosts=false)"
      }
    },
    "autoSizeByTrackedHosts": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "When true, App Service SKU + diagnostics + scheduler defaults are derived from trackedHostCount"
      }
    },
    "trackedHostCount": {
      "type": "int",
      "defaultValue": 25,
      "minValue": 1,
      "metadata": {
        "description": "Estimated number of hosts this deployment will track"
      }
    },
    "azureTenantId": {
      "type": "string",
      "metadata": {
        "description": "Azure AD tenant ID for OIDC auth"
      }
    },
    "azureClientId": {
      "type": "string",
      "metadata": {
        "description": "Azure AD client ID (app registration)"
      }
    },
    "azureClientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Azure AD client secret (store in Key Vault in production)"
      }
    },
    "dbAdminLogin": {
      "type": "string",
      "defaultValue": "stigadmin",
      "metadata": {
        "description": "PostgreSQL administrator login"
      }
    },
    "dbAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "PostgreSQL administrator password"
      }
    },
    "mockMode": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Demo mode — serves seeded sample data, disables sign-in and accepts every API request unauthenticated. Never enable for a deployment holding real data."
      }
    },
    "cloudEnvironment": {
      "type": "string",
      "defaultValue": "AzureCloud",
      "allowedValues": [
        "AzureCloud",
        "AzureUSGovernment",
        "AzureUSGovernmentDoD"
      ],
      "metadata": {
        "description": "Target Azure cloud environment"
      }
    },
    "strictTraceability": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enforce strict finding traceability on exports"
      }
    },
    "lockdownNetworking": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "When true, disable public telemetry/query and require explicit ingress CIDR allow-list for App Services"
      }
    },
    "allowedIngressCidrs": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Allowed ingress CIDRs for frontend/backend when lockdownNetworking=true"
      }
    },
    "remediationTargetResourceGroupName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional resource group name containing VMs/Arc machines that this app may remediate"
      }
    },
    "enableScheduler": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Provision the scheduled-scan Azure Function App + Storage on a Consumption plan"
      }
    },
    "enableDiagnostics": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Forward backend + Function App diagnostics to Log Analytics so Sentinel/Splunk can pull from there"
      }
    },
    "businessHoursMode": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "When true, scheduled jobs only run during the configured business-hours window"
      }
    },
    "businessHoursTimeZone": {
      "type": "string",
      "defaultValue": "UTC",
      "metadata": {
        "description": "IANA timezone used for business-hours gating in the Function App (for example: UTC, America/New_York)"
      }
    },
    "businessHoursStartHour": {
      "type": "int",
      "defaultValue": 8,
      "minValue": 0,
      "maxValue": 23,
      "metadata": {
        "description": "Business-hours start hour (0-23, inclusive) in businessHoursTimeZone"
      }
    },
    "businessHoursEndHour": {
      "type": "int",
      "defaultValue": 18,
      "minValue": 0,
      "maxValue": 23,
      "metadata": {
        "description": "Business-hours end hour (0-23, exclusive) in businessHoursTimeZone"
      }
    },
    "autoShutdownOutsideBusinessHours": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "When true, the Function App will stop the web apps + PostgreSQL outside business hours and start them before business hours"
      }
    },
    "businessHoursStartCron": {
      "type": "string",
      "defaultValue": "0 45 7 * * 1-5",
      "metadata": {
        "description": "Start schedule for business-hours auto-start (NCRONTAB with seconds, UTC). Default: 07:45 UTC weekdays"
      }
    },
    "businessHoursStopCron": {
      "type": "string",
      "defaultValue": "0 15 18 * * 1-5",
      "metadata": {
        "description": "Stop schedule for business-hours auto-shutdown (NCRONTAB with seconds, UTC). Default: 18:15 UTC weekdays"
      }
    },
    "teamsWebhookUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional incoming-webhook URL for Microsoft Teams compliance drift alerts"
      }
    },
    "driftCat1Threshold": {
      "type": "int",
      "defaultValue": 0,
      "metadata": {
        "description": "CAT I open finding threshold for drift alerts (0 = alert on any open CAT I)"
      }
    },
    "backendImage": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Backend container image, e.g. ghcr.io/org/stig-backend@sha256:... Leave empty to deploy code from source (azd)."
      }
    },
    "frontendImage": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Frontend container image, e.g. ghcr.io/org/stig-frontend@sha256:... Leave empty to deploy code from source (azd)."
      }
    },
    "schedulerPackageUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Public URL of the scheduler Function zip package. Leave empty to deploy code from source (azd)."
      }
    }
  },
  "variables": {
    "planName": "[format('{0}-plan', parameters('baseName'))]",
    "backendName": "[format('{0}-api', parameters('baseName'))]",
    "frontendName": "[format('{0}-web', parameters('baseName'))]",
    "dbServerName": "[format('{0}-pg', parameters('baseName'))]",
    "dbName": "stigdashboard",
    "aiName": "[format('{0}-ai', parameters('baseName'))]",
    "lawName": "[format('{0}-law', parameters('baseName'))]",
    "funcName": "[format('{0}-func', parameters('baseName'))]",
    "funcStorageName": "[take(replace(format('{0}funcsa', parameters('baseName')), '-', ''), 24)]",
    "keyVaultName": "[take(replace(format('{0}-stig-kv', parameters('baseName')), '-', ''), 24)]",
    "kvSecretsUserRoleId": "4633458b-17de-457c-a5dd-322bbab69ee3",
    "isGov": "[or(equals(parameters('cloudEnvironment'), 'AzureUSGovernment'), equals(parameters('cloudEnvironment'), 'AzureUSGovernmentDoD'))]",
    "appHostSuffix": "[if(variables('isGov'), 'azurewebsites.us', 'azurewebsites.net')]",
    "authorityHost": "[if(variables('isGov'), 'https://login.microsoftonline.us', 'https://login.microsoftonline.com')]",
    "graphHost": "[if(variables('isGov'), 'https://graph.microsoft.us', 'https://graph.microsoft.com')]",
    "armHost": "[if(variables('isGov'), 'https://management.usgovcloudapi.net', 'https://management.azure.com')]",
    "backendLinuxFxVersion": "[if(empty(parameters('backendImage')), 'NODE|20-lts', format('DOCKER|{0}', parameters('backendImage')))]",
    "frontendLinuxFxVersion": "[if(empty(parameters('frontendImage')), 'NODE|20-lts', format('DOCKER|{0}', parameters('frontendImage')))]",
    "backendRegistryUrl": "[format('https://{0}', first(split(parameters('backendImage'), '/')))]",
    "frontendRegistryUrl": "[format('https://{0}', first(split(parameters('frontendImage'), '/')))]",
    "autoAppServiceSku": "[if(lessOrEquals(parameters('trackedHostCount'), 150), 'B1', 'S1')]",
    "autoEnableScheduler": "[greater(parameters('trackedHostCount'), 25)]",
    "autoEnableDiagnostics": "[greater(parameters('trackedHostCount'), 150)]",
    "effectiveAppServiceSku": "[if(parameters('autoSizeByTrackedHosts'), variables('autoAppServiceSku'), parameters('appServiceSku'))]",
    "effectiveEnableScheduler": "[if(parameters('autoSizeByTrackedHosts'), variables('autoEnableScheduler'), parameters('enableScheduler'))]",
    "effectiveEnableDiagnostics": "[if(parameters('autoSizeByTrackedHosts'), variables('autoEnableDiagnostics'), parameters('enableDiagnostics'))]",
    "enableBusinessHoursShutdown": "[and(and(variables('effectiveEnableScheduler'), parameters('businessHoursMode')), parameters('autoShutdownOutsideBusinessHours'))]"
