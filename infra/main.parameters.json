{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "baseName":           { "value": "${AZURE_BASE_NAME=stigdash}" },
    "location":           { "value": "${AZURE_LOCATION}" },
    "cloudEnvironment":   { "value": "${AZURE_CLOUD_ENVIRONMENT=AzureCloud}" },
    "appServiceSku":      { "value": "${APP_SERVICE_SKU=B1}" },
    "autoSizeByTrackedHosts": { "value": "${AUTO_SIZE_BY_TRACKED_HOSTS=true}" },
    "trackedHostCount":   { "value": "${TRACKED_HOST_COUNT=25}" },
    "azureTenantId":      { "value": "${AZURE_TENANT_ID}" },
    "azureClientId":      { "value": "${AZURE_CLIENT_ID}" },
    "azureClientSecret":  { "value": "${AZURE_CLIENT_SECRET}" },
    "dbAdminLogin":       { "value": "${DB_ADMIN_LOGIN=stigadmin}" },
    "dbAdminPassword":    { "value": "${DB_ADMIN_PASSWORD}" },
    "mockMode":           { "value": "${MOCK_MODE=false}" },
    "strictTraceability": { "value": "${STRICT_TRACEABILITY=true}" },
    "enableScheduler":    { "value": "${ENABLE_SCHEDULER=true}" },
    "enableDiagnostics":  { "value": "${ENABLE_DIAGNOSTICS=true}" },
    "businessHoursMode":  { "value": "${BUSINESS_HOURS_MODE=false}" },
    "businessHoursTimeZone": { "value": "${BUSINESS_HOURS_TIME_ZONE=UTC}" },
    "businessHoursStartHour": { "value": "${BUSINESS_HOURS_START_HOUR=8}" },
    "businessHoursEndHour": { "value": "${BUSINESS_HOURS_END_HOUR=18}" },
    "autoShutdownOutsideBusinessHours": { "value": "${AUTO_SHUTDOWN_OUTSIDE_BUSINESS_HOURS=false}" },
    "businessHoursStartCron": { "value": "${BUSINESS_HOURS_START_CRON=0 45 7 * * 1-5}" },
    "businessHoursStopCron": { "value": "${BUSINESS_HOURS_STOP_CRON=0 15 18 * * 1-5}" }
  }
}
