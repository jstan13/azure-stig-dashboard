# ============================================================
# azure-stig-dashboard — Sample Environment Variables
# Copy this file to .env (backend) and frontend/.env
# NEVER commit real secrets to source control.
# In production, use Azure Key Vault references or App Service
# "Application Settings" (encrypted at rest).
# ============================================================

# ─────────────────────────────────────────────
# BACKEND  (backend/.env  or  App Service settings)
# ─────────────────────────────────────────────

# Node environment: development | production | test
NODE_ENV=development

# Set to "true" to use in-memory mock data — no Azure credentials needed.
# All Azure SDK calls are bypassed. Auth middleware injects a synthetic admin user.
# Remove or set to "false" for a real deployment.
MOCK_MODE=true

# TCP port the Express server listens on.
PORT=3001

# ── Azure AD (required in non-mock mode) ──────────────────

# Your Azure AD tenant ID (Entra ID > Overview > Tenant ID)
AZURE_TENANT_ID=

# Client ID of the backend app registration
# (App Registrations > your-app > Overview > Application (client) ID)
AZURE_CLIENT_ID=

# Client secret for the backend app registration
# (App Registrations > your-app > Certificates & secrets > New client secret)
# Use Key Vault reference in production:  @Microsoft.KeyVault(SecretUri=https://...)
AZURE_CLIENT_SECRET=

# ── Database ──────────────────────────────────────────────

# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Leave empty when MOCK_MODE=true — in-memory store is used instead.
DATABASE_URL=postgresql://stiguser:changeme@localhost:5432/stigdb

# Set to "true" to enable SSL for the database connection (required in Azure PaaS).
DB_SSL=false

# ── CORS ──────────────────────────────────────────────────

# Origin(s) allowed to call the API.
# In local dev this is the Vite dev server.
# In production set this to your frontend App Service URL.
FRONTEND_URL=http://localhost:5173

# ── Logging ───────────────────────────────────────────────

# Winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# ── Application Insights (optional) ──────────────────────

# Set to your Application Insights instrumentation key to enable telemetry.
# Leave empty to disable (no errors).
APPINSIGHTS_INSTRUMENTATIONKEY=

# ── Scheduler ────────────────────────────────────────────

# node-cron expression for the automated full scan.
# Default: 2:00 AM every day  →  "0 2 * * *"
SCAN_CRON_SCHEDULE=0 2 * * *

# Azure Subscription IDs to scan (comma-separated).
# If empty, the connector will discover all subscriptions the MSI has access to.
AZURE_SUBSCRIPTION_IDS=

# ─────────────────────────────────────────────
# FRONTEND  (frontend/.env  or  App Service settings)
# VITE_ prefix is required — Vite embeds these at build time.
# ─────────────────────────────────────────────

# Azure AD application (client) ID registered for the frontend SPA.
# (App Registrations > your-frontend-app > Overview > Application (client) ID)
VITE_AZURE_CLIENT_ID=

# Azure AD tenant ID — same value as AZURE_TENANT_ID above.
VITE_AZURE_TENANT_ID=

# OAuth 2.0 scope the frontend requests a token for.
# Format: api://<BACKEND_CLIENT_ID>/access_as_user
# e.g.:   api://11111111-2222-3333-4444-555555555555/access_as_user
VITE_API_SCOPE=api://<BACKEND_CLIENT_ID>/access_as_user

# Set to "true" to bypass MSAL token acquisition in the frontend (pairs with MOCK_MODE=true in backend).
# Requests are sent without an Authorization header; the backend accepts them in mock mode.
VITE_MOCK_MODE=true

# Base URL of the backend API, used by the Axios client.
# In local dev with the Vite proxy configured this should be empty (requests go to /api/*).
# Set to the backend App Service URL in production if not using the nginx proxy.
VITE_API_URL=http://localhost:3001
